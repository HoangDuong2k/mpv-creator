{
  "name": "playlist-video-maker",
  "productName": "Playlist Video Maker",
  "version": "0.1.0",
  "description": "Ứng dụng desktop dựng video playlist nhạc: cột sóng, hiệu ứng theo nhạc, nút đăng ký/like YouTube",
  "main": "./out/main/index.js",
  "author": "Hoang Duong",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "cli": "tsx scripts/cli.ts",
    "dist": "electron-vite build && electron-builder",
    "e2e": "tsx scripts/e2e-smoke.ts",
    "test-audio": "tsx scripts/make-test-audio.ts",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dev:linux": "electron-vite dev --noSandbox"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "immer": "^11.1.18",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
